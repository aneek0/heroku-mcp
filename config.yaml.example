heroku_mcp:
  api_id: 12345       # замени на свой из https://my.telegram.org
  api_hash: abcdef1234567890abcdef1234567890  # замени на свой
  session_path: sessions/heroku_mcp
  server_port: 6767

  # --- Удалённый доступ по HTTP (streamable HTTP, эндпоинт POST /mcp) ---
  # Адрес, на котором слушать MCP. 127.0.0.1 = только локально (по умолчанию).
  # Любой другой адрес открывает порт сети, поэтому без auth_token сервер
  # откажется запускаться. Проще оставить 127.0.0.1 и идти по туннелю:
  #   ssh -N -L 6767:127.0.0.1:6767 user@server
  server_host: 127.0.0.1
  # Токен для каждого запроса: "Authorization: Bearer <token>" (или "X-Api-Key: <token>").
  # Сгенерировать: openssl rand -hex 32
  # auth_token: ""
  # Только для доверенной сети: разрешить внешний bind без токена (при старте
  # будет предупреждение в лог).
  # allow_unauthenticated: false
  # Дополнительные значения Host/Origin, которые примет DNS-rebinding защита
  # (домен туннеля или reverse proxy). В env — JSON-список.
  # allowed_hosts:
  #   - mcp.example.com
  # module_base_url: https://mcp.example.com/modules

  # Куда отправляются команды. Варианты:
  #   "me"                     — Saved Messages
  #   "@username" или id        — чат/канал
  #   ссылка на топик          — "https://t.me/c/3537976236/7"
  #     (чат + топик извлекаются из ссылки автоматически)
  # Топик можно задать и отдельно: her_chat_id: 3537976236 + her_topic_id: 7
  her_chat_id: me
  # her_topic_id: 7   # только для форум-чатов; 0/отсутствие = весь чат
  modules_dir: modules
  restart_boot_wait: 30
  # Прокси для подключения к Telegram (необязательно).
  # Поддерживаются:
  #   MTProto:  "tg://proxy?server=203.0.113.1&port=1443&secret=dd00112233445566778899aabbccddee1"
  #             (то же самое в виде https://t.me/proxy?...)
  #   SOCKS5:   "socks5://127.0.0.1:1080" или "socks5://user:pass@host:port"
  #   SOCKS4:   "socks4://host:port"
  #   HTTP:     "http://host:port"
  #   Ссылка:   "tg://socks?server=...&port=...&user=...&pass=..." (t.me/socks)
  # Пусто или отсутствие ключа = прямое подключение.
  # proxy: "tg://proxy?server=203.0.113.1&port=1443&secret=dd00112233445566778899aabbccddee1"

  # Пул прокси (необязательно): URL текстового файла со списком прокси,
  # по одной ссылке на строку (tg://proxy?..., socks5://host:port, ...).
  # При подключении сервер перебирает кандидатов по кругу, пока один не
  # сработает; нерабочие пропускаются автоматически. Основной `proxy` тоже
  # остаётся кандидатом (первым). Если все кандидаты легли — список
  # перезакачивается при следующем реконнекте.
  # proxy_list_url: "https://example.org/proxies.txt"

  # Таймаут MTProto-рукопожатия на одного кандидата пула, сек.
  # proxy_check_timeout: 10.0
